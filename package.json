{
	"name": "niijima-treasury",
	"private": true,
	"version": "0.1.0",
	"description": "Niijima Treasury: a private, self-hosted finance tracker for the Niijima Network.",
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "node -e \"require('node:fs').mkdirSync('drive-dev', { recursive: true })\" && pnpm --filter @treasure/app dev",
		"build": "pnpm --filter @treasure/app build",
		"start": "pnpm --filter @treasure/app start",
		"check": "pnpm -r --if-present check",
		"lint": "prettier --check . && eslint . && node scripts/check-styles.mjs",
		"format": "prettier --write .",
		"test": "vitest run && pnpm --filter @treasure/app test",
		"test:watch": "vitest",
		"style:check": "node packages/style/src/cli.ts",
		"db:generate": "pnpm --filter @treasure/db generate",
		"keygen": "node packages/db/src/keygen.ts",
		"verify": "pnpm lint && pnpm check && pnpm test && pnpm build"
	},
	"devDependencies": {
		"@treasure/core": "workspace:*",
		"@treasure/stats-sdk": "workspace:*",
		"@treasure/ui": "workspace:*",
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.19.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^4.1.12"
	}
}
