# Copy to .env next to compose.yml and fill in. Never commit .env.

# ── Secrets ──────────────────────────────────────────────────────────────────
# Encrypts the snapshots on Drive. Create with:  pnpm keygen
# Also store it in a password manager: without it the Drive backups can't be opened.
SNAPSHOT_KEY=

# Discord sign-in (https://discord.com/developers/applications → your app → OAuth2).
# Add this exact Redirect there:  https://treasure.niijimasisters.com/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Signs login cookies. Any long random string:  openssl rand -hex 32
SESSION_SECRET=
# Optional: sign in once for every Niijima app (Calendar, Archive, Home…). Set the same
# domain and the same SESSION_SECRET in each app's .env. Empty = this app only.
SESSION_DOMAIN=
# The address you open the app at, without a trailing slash.
PUBLIC_URL=https://treasure.niijimasisters.com
# "discord" (default) or "off". Only use "off" on your own machine.
ACCESS_MODE=discord

# Token the Niijima Network homepage uses to read /api/summary. Any long random
# string, e.g. from:  openssl rand -hex 32   Leave empty to turn the feed off.
SUMMARY_TOKEN=

# Optional: a Discord channel webhook for Verdicts (budget over, balance dipping, backups
# failing). Discord → channel settings → Integrations → Webhooks → New → Copy URL.
DISCORD_WEBHOOK_URL=

# ── Server setup (used by compose.yml) ───────────────────────────────────────
# Public address Traefik routes to the app.
TREASURE_HOST=treasure.niijimasisters.com
# The host folder where Drive's Niijima-network/Treasure is mounted by rclone.
# It must exist (and be mounted) before the first start.
TREASURE_DRIVE_DIR=/mnt/treasure
# The Docker network Traefik listens on, and its entrypoint name.
TRAEFIK_NETWORK=zipline_default
TRAEFIK_ENTRYPOINT=web
# User and group the app runs as; match the owner of the rclone mount (id -u, id -g).
PUID=1000
PGID=1000
